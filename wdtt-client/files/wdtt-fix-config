#!/bin/sh
# Нормализация /etc/config/wdtt: ghost option domain, multiline hashes, broken uci list domain

WDtt_CFG=/etc/config/wdtt

log() { logger -t wdtt-fix-config "$*"; }

[ -f "$WDtt_CFG" ] || { log "ERROR: $WDtt_CFG missing"; exit 1; }

[ -f /usr/libexec/wdtt/domain-lib.sh ] && . /usr/libexec/wdtt/domain-lib.sh

# Фоллбэк, если domain-lib.sh отсутствует (старый образ роутера).
if ! type normalize_domain_list_text >/dev/null 2>&1; then
	normalize_domain() {
		local d="$1"
		d="${d#https://}"; d="${d#http://}"; d="${d%%/*}"; d="${d%/}"
		printf '%s' "$d" | tr 'A-Z' 'a-z'
	}
	is_ghost_domain() {
		case "$1" in
		2iw.*|*.2iw.*|*2iw.rl|*2iw.io) return 0 ;;
		yoltlbe.com|*.yoltlbe.com|yoltlbe) return 0 ;;
		esac
		return 1
	}
	defragment_domain_list_text() {
		local text="$1" prev="" tld
		while [ "$text" != "$prev" ]; do
			prev="$text"
			for tld in com ru net org io tv me info biz dev app xyz online site pro cc rf su; do
				text="$(printf '%s' "$text" | sed "s/\\.${tld}\\([a-z0-9]\\)/.${tld} \\1/g")"
			done
		done
		printf '%s' "$text"
	}
	normalize_domain_list_text() {
		local text="$1" d out=""
		text="$(printf '%s' "$text" | tr 'A-Z' 'a-z')"
		text="$(defragment_domain_list_text "$text")"
		text="$(printf '%s' "$text" | tr ',;\n\r\t' ' ')"
		for d in $text; do
			d="$(normalize_domain "$d")"
			[ -n "$d" ] || continue
			is_ghost_domain "$d" && continue
			case "$d" in *.*) ;; *) continue ;; esac
			case ",$out," in *",$d,"*) continue ;; esac
			[ -n "$out" ] && out="${out},${d}" || out="$d"
		done
		printf '%s' "$out"
	}
	wdtt_uci_clear_domain_list() {
		local section="$1"
		[ -n "$section" ] || return 1
		[ -x /sbin/uci ] || return 0
		uci -q delete "wdtt.${section}.domain_list" 2>/dev/null
		while uci -q delete "wdtt.${section}.domain_list[0]" 2>/dev/null; do :; done
		while uci -q delete "wdtt.${section}.domain[0]" 2>/dev/null; do :; done
		while uci -q delete "wdtt.${section}.domain" 2>/dev/null; do :; done
	}
	wdtt_uci_set_domain_list() {
		local section="$1" domains="$2"
		domains="$(normalize_domain_list_text "$domains")"
		[ -n "$section" ] || return 1
		[ -n "$domains" ] || return 1
		[ -x /sbin/uci ] || return 0
		wdtt_uci_clear_domain_list "$section"
		uci -q batch <<-EOB
			set wdtt.${section}.domain_list='${domains}'
			commit wdtt
		EOB
	}
fi

if ! type merge_domain_list_text >/dev/null 2>&1; then
	merge_domain_list_text() {
		local a="$1" b="$2"
		if [ -n "$a" ] && [ -n "$b" ]; then
			normalize_domain_list_text "$a,$b"
		elif [ -n "$a" ]; then
			normalize_domain_list_text "$a"
		elif [ -n "$b" ]; then
			normalize_domain_list_text "$b"
		fi
	}
fi

trim_line() {
	local line="$1"
	line="${line#"${line%%[![:space:]]*}"}"
	line="${line%"${line##*[![:space:]]}"}"
	printf '%s' "$line"
}

parse_list_domain_line() {
	local line="$1" val
	case "$line" in
		list\ domains\ *) val="${line#list domains}" ;;
		list\ domain\ *) val="${line#list domain}" ;;
		*) return 1 ;;
	esac
	val="$(trim_line "$val")"
	case "$val" in
		\'*\') val="${val#\'}"; val="${val%\'}" ;;
		\"*\") val="${val#\"}"; val="${val%\"}" ;;
	esac
	[ -n "$val" ] || return 1
	printf '%s' "$val"
}

uci_line_value() {
	local line="$1" val
	val="${line#*\'}"
	if [ "$val" != "$line" ]; then
		val="${val%%\'*}"
		printf '%s' "$val"
		return 0
	fi
	val="${line#*\"}"
	val="${val%%\"*}"
	printf '%s' "$val"
}

collect_domain_list_uci() {
	local section="$1" val="" i=0 merged="" has_list=0

	[ -n "$section" ] || return 0
	[ -x /sbin/uci ] || return 0

	if uci -q show "wdtt.${section}" 2>/dev/null | grep -qE "^wdtt\.${section}\.domain_list\["; then
		has_list=1
	fi

	if [ "$has_list" -eq 1 ]; then
		i=0
		while val="$(uci -q get "wdtt.${section}.domain_list[$i]" 2>/dev/null)" && [ -n "$val" ]; do
			merged="$(merge_domain_list_text "$merged" "$val")"
			i=$((i + 1))
		done
	else
		val="$(uci -q get "wdtt.${section}.domain_list" 2>/dev/null)" || val=""
		merged="$(normalize_domain_list_text "$val")"
	fi

	i=0
	while val="$(uci -q get "wdtt.${section}.domain[$i]" 2>/dev/null)" && [ -n "$val" ]; do
		merged="$(merge_domain_list_text "$merged" "$val")"
		i=$((i + 1))
	done

	normalize_domain_list_text "$merged"
}

read_rule_domains_from_file() {
	local want="$1" line section="" domains="" in_rule=0 val

	[ -n "$want" ] || return 0
	[ -r "$WDtt_CFG" ] || return 0

	while read -r line || [ -n "$line" ]; do
		line="$(trim_line "$line")"
		case "$line" in
			""|\#*) continue ;;
			config\ rule\ *)
				section="${line#config rule }"
				section="${section#\'}"; section="${section%%\'*}"
				section="${section#\"}"; section="${section%%\"*}"
				section="${section%% *}"
				if [ "$section" = "$want" ]; then
					in_rule=1
					domains=""
				else
					in_rule=0
				fi
				continue
				;;
			config\ *)
				in_rule=0
				continue
				;;
		esac
		[ "$in_rule" -eq 1 ] || continue
		case "$line" in
			option\ domain_list\ *)
				val="$(uci_line_value "$line")"
				domains="$(merge_domain_list_text "$domains" "$val")"
				;;
			list\ domain|list\ domain\ *|list\ domains|list\ domains\ *)
				val="$(parse_list_domain_line "$line")" || continue
				domains="$(merge_domain_list_text "$domains" "$val")"
				;;
		esac
	done < "$WDtt_CFG"
	printf '%s' "$domains"
}

flush_rule_domain_list() {
	local section="$1" merged="$2" tmp="$3"
	merged="$(normalize_domain_list_text "$merged")"
	[ -n "$merged" ] || return 0
	echo "	option domain_list '${merged}'" >> "$tmp"
	wdtt_uci_set_domain_list "$section" "$merged"
	log "rule ${section}: domain_list=${merged}"
}

# LuCI DynamicList (list domain) на OpenWrt 25 даёт ghost 2iw.rl — мигрируем в option domain_list
migrate_rules_to_domain_list() {
	local tmp line trimmed section="" in_rule=0 val merged="" changed=0

	grep -qE 'list domain|option domain[^_]' "$WDtt_CFG" 2>/dev/null || return 0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		trimmed="$(trim_line "$line")"
		case "$trimmed" in
			config\ rule\ *)
				[ -n "$section" ] && flush_rule_domain_list "$section" "$merged" "$tmp"
				section="${trimmed#config rule }"
				section="${section#\'}"; section="${section%%\'*}"
				section="${section#\"}"; section="${section%%\"*}"
				section="${section%% *}"
				in_rule=1
				merged=""
				changed=1
				echo "$line" >> "$tmp"
				;;
			config\ *)
				[ -n "$section" ] && flush_rule_domain_list "$section" "$merged" "$tmp"
				section=""
				in_rule=0
				merged=""
				echo "$line" >> "$tmp"
				;;
			*)
				if [ "$in_rule" -eq 1 ]; then
					case "$trimmed" in
						list\ domain|list\ domain\ *|list\ domains|list\ domains\ *)
							val="$(parse_list_domain_line "$trimmed")" || continue
							merged="$(merge_domain_list_text "$merged" "$val")"
							changed=1
							continue
							;;
						option\ domain_list\ *)
							val="$(uci_line_value "$trimmed")"
							merged="$(merge_domain_list_text "$merged" "$val")"
							changed=1
							continue
							;;
						option\ domain|option\ domains*)
							changed=1
							continue
							;;
					esac
				fi
				echo "$line" >> "$tmp"
				;;
		esac
	done < "$WDtt_CFG"

	[ -n "$section" ] && flush_rule_domain_list "$section" "$merged" "$tmp"

	if [ "$changed" -eq 1 ]; then
		mv "$tmp" "$WDtt_CFG"
		[ -x /sbin/uci ] && uci -q commit wdtt 2>/dev/null
		log "migrated list domain → domain_list (LuCI-safe)"
	else
		rm -f "$tmp"
	fi
}

fix_option_domain_lines() {
	local tmp changed=0

	grep -qE '^[[:space:]]*option domain[[:space:]]' "$WDtt_CFG" 2>/dev/null && changed=1
	grep -qE '^[[:space:]]*option domains[[:space:]]' "$WDtt_CFG" 2>/dev/null && changed=1
	[ "$changed" -eq 1 ] || return 0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	grep -Ev '^[[:space:]]*option domain[[:space:]]' "$WDtt_CFG" \
		| grep -Ev '^[[:space:]]*option domains[[:space:]]' > "$tmp" \
		|| { rm -f "$tmp"; return 1; }
	mv "$tmp" "$WDtt_CFG"
	log "removed legacy option domain lines"
}

# list domain в globals — LuCI/uci ghost (2iw.io); routing читает только config rule
fix_globals_list_domains() {
	local tmp line section="" in_globals=0 changed=0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		case "$line" in
			config\ globals\ *)
				section="globals"
				in_globals=1
				echo "$line" >> "$tmp"
				continue
				;;
			config\ *)
				in_globals=0
				section=""
				echo "$line" >> "$tmp"
				continue
				;;
		esac
		if [ "$in_globals" -eq 1 ]; then
			case "$line" in
				*list\ domain*|*list\ domains*)
					changed=1
					continue
					;;
			esac
		fi
		echo "$line" >> "$tmp"
	done < "$WDtt_CFG"

	if [ "$changed" -eq 1 ]; then
		mv "$tmp" "$WDtt_CFG"
		log "removed list domain from globals section"
	else
		rm -f "$tmp"
	fi

	[ -x /sbin/uci ] || return 0
	uci -q delete wdtt.globals.domain 2>/dev/null
	uci -q delete wdtt.globals.domains 2>/dev/null
}

# LuCI/UCI ghost: 2ip.ru→2iw.rl, youtube.com→yoltlbe.com — удаляем из файла напрямую
purge_ghost_list_domains_from_file() {
	local tmp line trimmed val changed=0

	grep -qE '(2iw\.|yoltlbe)' "$WDtt_CFG" 2>/dev/null || return 0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		trimmed="$(trim_line "$line")"
		case "$trimmed" in
			list\ domain|list\ domain\ *|list\ domains|list\ domains\ *)
				val="$(parse_list_domain_line "$trimmed")" || {
					echo "$line" >> "$tmp"
					continue
				}
				case "$val" in
				*2iw*|*yoltlbe*)
					changed=1
					log "remove ghost list domain from file: ${val}"
					continue
					;;
				esac
				;;
			option\ domain_list\ *)
				val="$(uci_line_value "$trimmed")"
				val="$(normalize_domain_list_text "$val")"
				if [ -n "$val" ]; then
					echo "	option domain_list '${val}'" >> "$tmp"
				else
					changed=1
				fi
				continue
				;;
		esac
		echo "$line" >> "$tmp"
	done < "$WDtt_CFG"

	if [ "$changed" -eq 1 ]; then
		mv "$tmp" "$WDtt_CFG"
		log "purged ghost domains from ${WDtt_CFG}"
	else
		rm -f "$tmp"
	fi
}

sanitize_rule_domain_list_uci() {
	local section="$1" val
	[ -n "$section" ] || return 0
	[ -x /sbin/uci ] || return 0

	val="$(read_rule_domains_from_file "$section")"
	[ -z "$val" ] && val="$(uci -q get "wdtt.${section}.domain_list" 2>/dev/null)"
	val="$(normalize_domain_list_text "$val")"
	if [ -n "$val" ]; then
		wdtt_uci_set_domain_list "$section" "$val"
	fi
	while uci -q delete "wdtt.${section}.domain" 2>/dev/null; do :; done
}

# option domain_list вне config rule (LuCI-баг) → первая rule-секция
fix_orphan_domain_list() {
	local tmp line trimmed section="" in_rule=0 orphan="" target="" injected=0 changed=0 val

	grep -qE '^[[:space:]]*option domain_list[[:space:]]' "$WDtt_CFG" 2>/dev/null || return 0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		trimmed="$(trim_line "$line")"
		case "$trimmed" in
			config\ rule\ *)
				section="${trimmed#config rule }"
				section="${section#\'}"; section="${section%%\'*}"
				section="${section#\"}"; section="${section%%\"*}"
				section="${section%% *}"
				in_rule=1
				[ -z "$target" ] && target="$section"
				echo "$line" >> "$tmp"
				if [ -n "$orphan" ] && [ "$injected" -eq 0 ]; then
					echo "	option domain_list '${orphan}'" >> "$tmp"
					if [ -x /sbin/uci ]; then
						uci -q set "wdtt.${section}.domain_list=${orphan}" 2>/dev/null
						uci -q set "wdtt.${section}.enabled=1" 2>/dev/null
						uci -q set "wdtt.${section}.type=route" 2>/dev/null
					fi
					injected=1
					orphan=""
					changed=1
				fi
				continue
				;;
			config\ *)
				in_rule=0
				section=""
				echo "$line" >> "$tmp"
				continue
				;;
			option\ domain_list\ *)
				val="$(uci_line_value "$trimmed")"
				val="$(normalize_domain_list_text "$val")"
				if [ "$in_rule" -eq 1 ]; then
					[ -n "$val" ] && echo "	option domain_list '${val}'" >> "$tmp"
				elif [ -n "$val" ]; then
					orphan="$(merge_domain_list_text "$orphan" "$val")"
					changed=1
				fi
				continue
				;;
		esac
		echo "$line" >> "$tmp"
	done < "$WDtt_CFG"

	if [ "$changed" -eq 1 ]; then
		mv "$tmp" "$WDtt_CFG"
		log "moved orphan domain_list into rule ${target:-unknown}"
	else
		rm -f "$tmp"
	fi
}

# LuCI TextValue с переносами ломает UCI: option domain_list 'youtube.com  (без ')
fix_multiline_domain_list() {
	local tmp line in_domain=0 payload="" prefix=""

	grep -q 'option domain_list' "$WDtt_CFG" 2>/dev/null || return 0
	if grep -E "^[[:space:]]*option domain_list '[^']+'[[:space:]]*$" "$WDtt_CFG" >/dev/null 2>&1; then
		return 0
	fi

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		case "$line" in
			*"option domain_list"*)
				in_domain=1
				prefix="${line%%option domain_list*}"
				line="${line#*option domain_list}"
				line="$(echo "$line" | sed 's/^[[:space:]]*//')"
				payload="${line#\'}"
				if [ "$payload" != "$line" ]; then
					case "$payload" in
						*\'*)
							payload="${payload%%\'*}"
							payload="$(normalize_domain_list_text "$payload")"
							[ -n "$payload" ] && echo "${prefix}option domain_list '${payload}'" >> "$tmp"
							in_domain=0
							payload=""
							continue
							;;
					esac
				else
					payload=""
				fi
				continue
				;;
		esac
		if [ "$in_domain" -eq 1 ]; then
			line="$(trim_line "$line")"
			case "$line" in
			*option\ domain_list*)
				[ -n "$payload" ] && payload="$(normalize_domain_list_text "$payload")"
				[ -n "$payload" ] && echo "${prefix}option domain_list '${payload}'" >> "$tmp"
				in_domain=1
				prefix="${line%%option domain_list*}"
				line="${line#*option domain_list}"
				line="$(echo "$line" | sed 's/^[[:space:]]*//')"
				payload="${line#\'}"
				case "$payload" in
				*\'*)
					payload="${payload%%\'*}"
					payload="$(normalize_domain_list_text "$payload")"
					[ -n "$payload" ] && echo "${prefix}option domain_list '${payload}'" >> "$tmp"
					in_domain=0
					payload=""
					;;
				esac
				continue
				;;
			\'*\')
					line="${line#\'}"
					line="${line%\'}"
					[ -n "$payload" ] && payload="${payload},${line}" || payload="$line"
					payload="$(normalize_domain_list_text "$payload")"
					[ -n "$payload" ] && echo "${prefix}option domain_list '${payload}'" >> "$tmp"
					in_domain=0
					payload=""
					continue
					;;
				*)
					[ -n "$line" ] && payload="${payload:+$payload,}${line}"
					continue
					;;
			esac
		fi
		echo "$line" >> "$tmp"
	done < "$WDtt_CFG"

	if [ "$in_domain" -eq 1 ] && [ -n "$payload" ]; then
		payload="$(normalize_domain_list_text "$payload")"
		[ -n "$payload" ] && echo "${prefix}option domain_list '${payload}'" >> "$tmp"
	fi

	mv "$tmp" "$WDtt_CFG"
	log "normalized multiline domain_list"
}

fix_multiline_hashes() {
	local tmp line in_hashes=0 payload="" prefix=""

	if grep -E "^[[:space:]]*option hashes '[^']+'[[:space:]]*$" "$WDtt_CFG" >/dev/null 2>&1; then
		return 0
	fi
	grep -q 'option hashes' "$WDtt_CFG" 2>/dev/null || return 0

	tmp="$(mktemp /tmp/wdtt-fix.XXXXXX)"
	while read -r line || [ -n "$line" ]; do
		case "$line" in
			*"option hashes"*)
				in_hashes=1
				prefix="${line%%option hashes*}"
				line="${line#*option hashes}"
				line="$(echo "$line" | sed "s/^[[:space:]]*//")"
				payload="${line#\'}"
				if [ "$payload" != "$line" ]; then
					case "$payload" in
						*\'*)
							payload="${payload%%\'*}"
							echo "${prefix}option hashes '${payload}'" >> "$tmp"
							in_hashes=0
							payload=""
							continue
							;;
					esac
				else
					payload="${line#\"}"
					payload="${payload%%\"*}"
					if [ -n "$payload" ] && [ "$line" != "$payload" ]; then
						echo "${prefix}option hashes '${payload}'" >> "$tmp"
						in_hashes=0
						payload=""
						continue
					fi
					payload=""
				fi
				continue
				;;
		esac
		if [ "$in_hashes" -eq 1 ]; then
			part="$(echo "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^'\''//; s/'\''$//; s/,$//')"
			[ -z "$part" ] && continue
			case "$line" in
				*\'*)
					part="${part%%\'*}"
					[ -n "$payload" ] && payload="${payload},${part}" || payload="$part"
					echo "${prefix}option hashes '${payload}'" >> "$tmp"
					in_hashes=0
					payload=""
					continue
					;;
			esac
			[ -n "$payload" ] && payload="${payload},${part}" || payload="$part"
			continue
		fi
		echo "$line" >> "$tmp"
	done < "$WDtt_CFG"

	if [ "$in_hashes" -eq 1 ] && [ -n "$payload" ]; then
		echo "${prefix}option hashes '${payload}'" >> "$tmp"
	fi

	mv "$tmp" "$WDtt_CFG"
	log "normalized multiline hashes"
}

fix_option_domain_lines
fix_globals_list_domains
fix_orphan_domain_list
fix_multiline_domain_list
fix_multiline_hashes
migrate_rules_to_domain_list
purge_ghost_list_domains_from_file
for _sec in $(grep -E "^config rule" "$WDtt_CFG" 2>/dev/null | sed "s/^config rule ['\"]\\([^'\"]*\\)['\"].*/\\1/"); do
	sanitize_rule_domain_list_uci "$_sec"
done
[ -x /sbin/uci ] && uci -q commit wdtt 2>/dev/null

if [ -x /sbin/uci ] && ! uci show wdtt 2>&1 | grep -qi 'parse error'; then
	val="$(uci -q get wdtt.globals.hashes 2>/dev/null)" || val=""
	if [ -n "$val" ]; then
		val="$(printf '%s' "$val" | tr '\n\r\t ' ',' | sed 's/,,*/,/g; s/^,//; s/,$//')"
		uci -q set "wdtt.globals.hashes=${val}"
		uci -q commit wdtt 2>/dev/null
	fi
fi

if uci show wdtt 2>&1 | grep -qi 'parse error'; then
	log "WARN: uci parse error remains"
	exit 1
fi

log "OK: config normalized"
exit 0
