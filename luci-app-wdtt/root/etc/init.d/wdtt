#!/bin/sh /etc/rc.common
# WDTT VPN client — procd service

START=90
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load wdtt
	config_get enabled globals enabled 0
	[ "$enabled" = "1" ] || return 0

	mkdir -p /var/run/wdtt

	procd_open_instance
	procd_set_param command /usr/sbin/wdttd
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wdtt
	procd_close_instance
}

stop_service() {
	if [ -x /usr/libexec/wdtt/datapath ]; then
		/usr/libexec/wdtt/datapath stop 2>/dev/null || true
	else
		/usr/libexec/wdtt/routing stop 2>/dev/null
		[ -x /usr/libexec/wdtt/full-tunnel ] && /usr/libexec/wdtt/full-tunnel stop 2>/dev/null || true
	fi
	# procd SIGTERM иногда не успевает при captcha wait — добиваем явно
	killall wdttd 2>/dev/null
	# Не оставляем LuCI со stale "connected"
	mkdir -p /var/run/wdtt
	cat > /var/run/wdtt/status.json <<'EOF'
{"running":false,"state":"stopped","rx_bytes":0,"tx_bytes":0,"workers":0,"wg_applied":false,"uptime_sec":0}
EOF
	iface="$(uci -q get wdtt.globals.iface 2>/dev/null)"
	iface="${iface:-wg-wdtt}"
	ip link del "$iface" 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger wdtt
}

reload_service() {
	# UCI reload: правила / режим маршрутизации, туннель не рвём
	[ -x /usr/libexec/wdtt/fix-config ] && /usr/libexec/wdtt/fix-config 2>/dev/null || true
	local iface
	iface="$(uci -q get wdtt.globals.iface 2>/dev/null)"
	iface="${iface:-wg-wdtt}"
	mkdir -p /var/run/wdtt
	if ip link show "$iface" >/dev/null 2>&1; then
		if [ -x /usr/libexec/wdtt/datapath ]; then
			/usr/libexec/wdtt/datapath ensure "$iface" 2>/dev/null || true
		else
			# legacy fallback
			mode="$(uci -q get wdtt.globals.routing_mode 2>/dev/null)"
			if [ "$mode" = "full" ]; then
				/usr/libexec/wdtt/routing stop 2>/dev/null || true
				[ -x /usr/libexec/wdtt/full-tunnel ] && /usr/libexec/wdtt/full-tunnel apply 2>/dev/null || true
			else
				/usr/libexec/wdtt/routing reload "$iface" 2>/dev/null || true
			fi
		fi
	fi
}
