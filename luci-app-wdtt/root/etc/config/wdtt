
config globals 'globals'
	option enabled '0'
	option peer ''
	option password ''
	option hashes ''
	option hash1 ''
	option hash2 ''
	option hash3 ''
	option hash4 ''
	option workers '12'
	option mtu '1240'
	option listen '127.0.0.1:9000'
	option turn_host ''
	option turn_port ''
	option captcha_mode 'wv'
	option vk_auth_mode 'vkcalls'
	# audio = OPUS PT 111 (совместимо со всеми серверами); video = PT 96 (нужен сервер с поддержкой)
	option obfs_mode 'audio'
	# DNS для VK API: doh-yandex|doh-cloudflare|doh-google|yandex|google|cloudflare|custom:IP|doh:URL
	option go_dns 'doh-yandex'
	# Транспорт до TURN-relay: udp (по умолчанию) | tcp — если провайдер душит UDP
	option turn_transport 'udp'
	option device_id ''
	option iface 'wg-wdtt'
	option tunnel_mode 'wg'
	# selective = правила WDTT; full = весь трафик; external = только туннель (Podkop/PBR)
	option routing_mode 'external'
	option uplink_iface 'auto'
	option active_profile ''

# Сохранённые профили подключения (LuCI → Профили). Не трогает routing/device_id.
